{
  "mcpServers": {
    "codex_scheduler": {
      "command": "node",
      "args": [
        "src\\mcp-server.mjs"
      ],
      "cwd": ".",
      "env": {
        "NODE_OPTIONS": "",
        "NODE_PATH": "",
        "PSModulePath": ""
      },
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 120,
      "env_vars": [
        "LOCALAPPDATA",
        "APPDATA",
        "USERPROFILE",
        "CODEX_HOME",
        "CODEX_CLI_PATH",
        "SCHEDULER_CODEX_PATH",
        "SCHEDULER_DATA_DIR",
        "PATH",
        "CODEX_APP_TOOLS_PIPE_PATH",
        "CODEX_THREAD_ID"
      ]
    }
  }
}
